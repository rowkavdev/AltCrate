{
  "name": "casepilot",
  "version": "0.3.19",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node tauri/scripts/desktop.cjs dev",
    "build": "node tauri/scripts/desktop.cjs build",
    "start": "node tauri/scripts/desktop.cjs start",
    "pretest": "install-electron && npm run build:electron",
    "test": "node --test tests/*.test.cjs",
    "package:linux": "node tauri/scripts/desktop.cjs build --bundles deb",
    "package:mac": "node tauri/scripts/desktop.cjs build",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start:electron": "electron .",
    "build:electron": "vite build",
    "package:mac:electron": "npm run build:electron && electron-builder --mac dir --publish never",
    "test:tauri": "node tauri/scripts/bundle-engine.cjs && node tauri/scripts/smoke-engine.cjs && node --test tauri/runtime/tests/*.test.cjs"
  },
  "build": {
    "appId": "pt.caseclicker.dashboard",
    "productName": "AltCrate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/**/__pycache__/**"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns"
    },
    "asar": true
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "engine.io-client": "^6.6.7",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.11.3",
    "electron-builder": "^26.15.3",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
