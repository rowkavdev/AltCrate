{
  "name": "casepilot-desktop",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm --filter web build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "theme:apply": "pnpm --filter web exec shadcn apply",
    "theme:inspect": "pnpm --filter web exec shadcn preset resolve --json"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~7.0.2",
    "@tauri-apps/cli": "^2.12.4"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
