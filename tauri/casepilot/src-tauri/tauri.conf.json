{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CasePilot",
  "version": "0.4.0",
  "identifier": "pt.casepilot.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/bundle-engine.cjs && pnpm --filter web dev --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node ../scripts/bundle-engine.cjs && pnpm --filter web build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CasePilot",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 620,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://case-clicker.com https://*.case-clicker.com https://steamcommunity-a.akamaihd.net; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/casepilot-node"
    ],
    "resources": {
      "../../runtime/engine/": "runtime/engine/",
      "../../runtime/strategy/": "runtime/strategy/",
      "../../runtime/scripts/": "runtime/scripts/",
      "../../runtime/package.json": "runtime/package.json"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
